{
	"name": "my-auto-export-site",
	"compatibility_date": "2026-10-01",
	"main": "worker/main.js",
	"assets": {
		"directory": "./my-auto-export",
		"binding": "ASSETS",
		// Ces fichiers passent par le Worker (worker/index.js, servirFichier) : liste des véhicules insérée dans
		// l'accueil, en-tête X-Robots-Tag de l'administration. Les autres fichiers sont servis directement.
		"run_worker_first": ["/", "/admin", "/admin.html"]
	},
	// Base de l'espace acheteur (production). Pour une nouvelle base : `npx wrangler d1 create my-auto-export`,
	// puis remplacer database_id par l'identifiant affiché (voir README).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-auto-export",
			"database_id": "9481f2d4-698c-4f6f-90e2-9532f9e44bcf",
			"migrations_dir": "migrations"
		}
	],
	// Photos envoyées depuis /admin.html (créé avec `npx wrangler r2 bucket create my-auto-export-photos`).
	// Le Worker lit env.PHOTOS ; en local, `wrangler dev` utilise un stockage local, pas celui de production.
	// Pas de binding DOCUMENTS : le téléchargement des factures PDF reste désactivé (voir README, « Factures PDF »).
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "my-auto-export-photos"
		}
	],
	// Contrôle SEO quotidien à 07:00, heure de Paris (worker/seo.js). Le Cron est en UTC : 05:00 UTC en été,
	// 06:00 UTC en hiver ; le Worker n'exécute que celui qui tombe à 07:00 à Paris. Inclus dans le plan gratuit.
	"triggers": {
		"crons": ["0 5 * * *", "0 6 * * *"]
	}
}
